<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_qty_limit" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.qty.limit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="Quantity Limits" help="Set maximum total quantity allowed per transaction for restricted products.">
                    <field name="enable_qty_limit"/>
                    <div class="content-group" invisible="not enable_qty_limit">
                        <div class="mt16 d-flex align-items-center">
                            <span class="fw-bold me-2">Limit: </span>
                            <field name="max_qty_limit" class="oe_inline fw-bold text-center" style="width: 60px;"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>