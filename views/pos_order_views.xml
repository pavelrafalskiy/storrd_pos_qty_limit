<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_inherit_qty_limit" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.qty.limit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']//list//field[@name='product_id']" position="after">
                <field name="has_qty_limit" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='lines']//form//field[@name='full_product_name']" position="after">
                <field name="has_qty_limit" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>